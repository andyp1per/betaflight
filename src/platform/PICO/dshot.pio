.program dshot_600
start:
    set    pins, 0                [31]      ; Set pin low [assumed pin already set for output]
    nop                           [20]      ; min delay 2us at DSHOT600 is 48 cycles, allow 56 before next set
    pull   block                            ; Block until someone puts something into the TX FIFO
    out    y, 16                            ; Discard top 16 bits
bitloop:
    out    y, 1                             ; Shift next bit into y
    jmp    !y, outzero                      ;
    set    pins, 1                [26]      ; To output a '1' bit, set high for 27 then low for 13
    set    pins, 0                [9]       ; Delay to next "set" adds up to 13
    jmp    !osre, bitloop                   ; If not done output then loop
    jmp    start
outzero:
    set    pins, 1                [12]      ; To output a '0', set high for 13 then low for 27
    set    pins, 0                [22]      ; Delay to next "set" adds up to 27
    jmp    !osre, bitloop         [1]       ; If not done output then loop


; DSHOT 600 bidir with edge detection receive
; Transmit: 14 instructions (2-15)
; Receive: 16 instructions (16-31, plus 0-1 for bit check/push)
; Total: 32 instructions (exactly at PIO limit)
;
; Key insight: wrap_target at next_bit (instruction 0) so both bit paths converge:
; - After 'in null, 1' (0 bit): explicit jmp to next_bit
; - After 'in osr, 1' (1 bit): .wrap to next_bit
; On init/restart, jump to offset+2 (start label) to skip receive logic.

.program dshot_600_bidir

.define public BIDIR_START 2    ; Offset to 'start' label for init/restart

.wrap_target
next_bit:
    jmp    x--, cont                        ; 0: More bits to read?
    push   noblock                          ; 1: Done - push telemetry to FIFO
start:
    set    pindirs, 1                       ; 2: Set output mode
    set    pins, 1                          ; 3: Idle high
    pull   block                            ; 4: Wait for TX data
    out    y, 16                            ; 5: Discard top 16 bits
bitloop:
    out    y, 1                             ; 6: Shift next bit into y
    jmp    !y, outzero                      ; 7: Branch based on bit value
outone:
    set    pins, 0                [26]      ; 8: '1' bit = LOW for 27, HIGH for 13
    set    pins, 1                [9]       ; 9:
    jmp    !osre, bitloop                   ; 10: Loop for all bits
    jmp    receive                          ; 11: Done transmitting
outzero:
    set    pins, 0                [12]      ; 12: '0' bit = LOW for 13, HIGH for 27
    set    pins, 1                [22]      ; 13:
    jmp    !osre, bitloop         [1]       ; 14: Loop for all bits (fall through when done)
receive:
    set    pindirs, 0                       ; 15: Switch to input
    set    x, 19                            ; 16: Read 20 bits (start bit consumed by wait)
    mov    osr, ~null                       ; 17: OSR = 0xFFFFFFFF for shifting in 1s
wait_low:
    jmp    pin, wait_low          [1]       ; 18: Wait for pin LOW (start of response)
    set    y, 6                             ; 19: Half-bit count for initial LOW measurement
meas_zero:
    jmp    pin, new_one                     ; 20: Pin went HIGH? -> measure HIGH
    jmp    y--, meas_zero                   ; 21: Keep counting while LOW
    in     null, 1                          ; 22: Timeout while LOW = 0 bit
    jmp    next_bit                         ; 23: Check if more bits (explicit jump)
cont:
    set    y, 13                  [1]       ; 24: Full-bit timing for subsequent bits
    jmp    pin, meas_one                    ; 25: Check current pin state
    jmp    meas_zero                        ; 26: Pin LOW, go measure LOW
new_one:
    set    y, 6                   [1]       ; 27: Half-bit count for measuring HIGH
meas_one:
    jmp    pin, cont_one                    ; 28: Still HIGH?
    jmp    meas_zero              [1]       ; 29: Went LOW - go measure LOW
cont_one:
    jmp    y--, meas_one                    ; 30: Keep counting while HIGH
    in     osr, 1                           ; 31: Timeout while HIGH = 1 bit
.wrap                                       ; Wraps to next_bit (instruction 0)
