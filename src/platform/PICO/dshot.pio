; Dummy program
.program dshot_600
dummy:
    jmp dummy


; DSHOT 600 bidirectional with edge detection receive
; Uses 'wait' instructions for precise edge detection (jmp pin is broken on RP2350)
;
; Transmit: 14 instructions (0-13)
; Receive: 18 instructions (14-31) - uses 'wait 1 pin' / 'wait 0 pin' for sync
; Total: 32 instructions

.program dshot_600_bidir

.define public BIDIR_START 0

.wrap_target
pull_data:
    pull   block                            ; 0: Wait for TX data
    set    pindirs, 1                       ; 1: Switch to output mode
    out    y, 16                            ; 2: Discard top 16 bits
    set    x, 20                            ; 3: 21 bits to transmit
bitloop_tx:
    out    y, 1                             ; 4: Shift bit to y
    set    pins, 0                          ; 5: Start of bit (LOW)
    jmp    !y, outzero_tx                   ; 6: Branch on bit value
outone_tx:
    nop                          [25]       ; 7: '1' = 27 cycles LOW total
    set    pins, 1               [9]        ; 8: then 13 cycles HIGH
    jmp    !osre, bitloop_tx                ; 9: Next bit if more
    jmp    receive                          ; 10: Done TX -> receive
outzero_tx:
    nop                          [11]       ; 11: '0' = 13 cycles LOW total
    set    pins, 1               [23]       ; 12: then 27 cycles HIGH
    jmp    !osre, bitloop_tx     [1]        ; 13: Next bit (fall through when done)

receive:
    set    pindirs, 0                       ; 14: Switch to input mode
    ; Wait for start bit (falling edge from idle HIGH)
    ; Using 'wait' instructions for precise, deterministic edge detection
    wait   1 pin 0                          ; 15: Wait for line to go HIGH (idle)
    wait   0 pin 0                          ; 16: Wait for falling edge (start bit)
    ; Falling edge detected precisely! Now oversample at 4x rate.
    ; At current clock (40 cycles/bit for TX), RX bit = 32 cycles at 5/4 rate.
    ; 4x oversampling = 8 cycles per sample.
    ; 21 bits * 4 samples = 84 samples minimum.
    ; Use nested loop: 4 outer * 32 inner = 128 samples (covers 32 bit periods)
    ; Autopush at 32 bits sends data to FIFO (4 words fits in default RX FIFO)
    ;
    ; 8 cycles per sample: in(1) + nop[4](5) + jmp(2) = 8 cycles

    set    x, 3                             ; 17: 4 outer loop iterations
outer_loop:
    set    y, 31                            ; 18: 32 inner loop iterations
inner_loop:
    in     pins, 1                          ; 19: Sample pin into ISR (autopush every 32)
    nop                          [4]        ; 20: Delay 5 cycles (1 + [4])
    jmp    y--, inner_loop                  ; 21: Continue inner loop (2 cycles when taken)
    jmp    x--, outer_loop                  ; 22: Continue outer loop

    ; Sampling complete - 128 samples pushed via autopush (4 x 32-bit words)
    ; Pad to 32 instructions (currently at 23, need 9 more nops)
    nop                                     ; 23
    nop                                     ; 24
    nop                                     ; 25
    nop                                     ; 26
    nop                                     ; 27
    nop                                     ; 28
    nop                                     ; 29
    nop                                     ; 30
    nop                                     ; 31
.wrap
